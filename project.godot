; ABYSS — retro sci-fi FPS campaign
config_version=5

[application]
config/name="ABYSS"
run/main_scene="res://scenes/Menu.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/description="A story-driven retro FPS campaign beneath the NOVA facility."

[autoload]
PauseMenu="*res://scripts/PauseMenu.gd"

[display]
window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.025, 0.035, 0.05, 1)
