; ABYSS — low-end friendly retro FPS campaign
config_version=5

[application]
config/name="ABYSS"
run/main_scene="res://scenes/Menu.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/description="A story-driven retro FPS campaign beneath the NOVA facility."

[autoload]
LowEnd="*res://scripts/LowEnd.gd"
CampaignState="*res://scripts/CampaignState.gd"
PauseMenu="*res://scripts/PauseMenu.gd"

[display]
window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=960
window/size/window_height_override=540
window/stretch/mode="viewport"
window/vsync/vsync_mode=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_2d=0
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.025, 0.035, 0.05, 1)
